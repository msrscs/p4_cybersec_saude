# Copie para .env e preencha. NUNCA versione o .env.
# Gere senhas fortes, ex.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Superusuário do container Postgres (apenas administração/bootstrap)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Ambiente: dev | test | prod
ENVIRONMENT=dev

# Senhas das roles criadas por backend/scripts/bootstrap_db.py:
#   app_user  -> API (só DML, sem DELETE/UPDATE no log)
#   migrator  -> Alembic (DDL)
# POSTGRES_USER acima NÃO pode se chamar app_user nem migrator.
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=

# Opcional: host/porta do banco vistos do WSL (padrão localhost:5433)
# DB_HOST=localhost
# DB_PORT=5433

# TLS até o Postgres (ADR-0013), para scripts, migrations e API fora do Docker. Produção exige
# verify-full. Certificados: infra/gerar_certificados.sh. O caminho da CA deve ser absoluto.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/caminho/absoluto/do/projeto/certs/ca.crt

# Opcional: GID do dono de certs/ (`id -g`, padrão 1000); os containers o usam para ler as chaves.
# CERTS_GID=1000

# Chaves de criptografia (ADR-0004). Gere com: cd backend && uv run python -m scripts.gerar_chaves
# KEK_KEYRING: versao:base64 (32 bytes) separados por vírgula; KEK_ATIVA: versão usada para cifrar.
# Rotação de KEK: uv run python -m scripts.gerar_chaves --rotacionar
# HMAC_KEY: chave dos hashes de busca (cpf_hash/email_hash). NÃO troque: invalida as buscas.
KEK_KEYRING=
KEK_ATIVA=
HMAC_KEY=

# Assina os checkpoints da cadeia do log (ADR-0010). Só o script scripts.verificar_log usa;
# não é passada ao container do backend. Gerada por scripts.gerar_chaves. NÃO troque.
LOG_CHECKPOINT_KEY=

# Custo do bcrypt (ADR-0003). Padrão 12; abaixo de 12 só com ENVIRONMENT=test.
# BCRYPT_ROUNDS=12
