# Copie para .env e preencha. NUNCA versione o .env.
# Gere senhas fortes, ex.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Superusuário do container Postgres (apenas administração/bootstrap)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Ambiente: dev | test | prod
ENVIRONMENT=dev

# Role da aplicação (só DML; criada na T02). Host "db" dentro do Docker, "localhost:5433" no WSL.
APP_DATABASE_URL=postgresql+psycopg://app_user:<senha>@db:5432/<banco>

# Role de migration (DDL), usada só pelo Alembic: uv run --project backend alembic upgrade head
MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:<senha>@localhost:5433/<banco>
