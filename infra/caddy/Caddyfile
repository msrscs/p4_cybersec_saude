# Borda do sistema (ADR-0013): único ponto exposto. TLS na entrada, TLS verificado até o frontend.
#
# Endereço canônico: cybersec.localhost. Nunca servir o sistema em "localhost": o HSTS que o
# frontend envia (com includeSubDomains) passaria a valer para todo projeto local do navegador.
{
	admin off
	auto_https off
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

https://cybersec.localhost:8443 {
	tls /certs/edge.crt /certs/edge.key {
		protocols tls1.2 tls1.3
	}
	# Sem trusted_proxies, o Caddy descarta o X-Forwarded-For do cliente e informa o IP real.
	reverse_proxy https://frontend:3000 {
		# Com upstream HTTPS o Caddy trocaria o Host; o frontend o compara com o Origin (CSRF).
		header_up Host {hostport}
		transport http {
			tls_server_name frontend
			tls_trust_pool file /certs/ca.crt
		}
	}
	header -Server
}

https://localhost:8443 {
	tls /certs/edge.crt /certs/edge.key {
		protocols tls1.2 tls1.3
	}
	redir https://cybersec.localhost:8443{uri} 308
}

http://:8080 {
	redir https://cybersec.localhost:8443{uri} 308
}
